# Copy to .env and fill in. Never commit .env.
#
# The OpenRouter key does NOT go here - paste it into Dify under
# Settings > Model Providers > OpenRouter. This script only talks to Dify.

# Dify app API key (Dify app > "API Access" > API Key, starts with "app-")
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Dify Cloud. If you self-host Dify, use e.g. http://localhost/v1
DIFY_BASE_URL=https://api.dify.ai/v1

# How many commits to roast by default
COMMIT_COUNT=20
