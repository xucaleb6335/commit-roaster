# Copy to .env and fill in. Never commit .env.

# --- Agent mode (python roast.py --agent): LangGraph agent calling OpenRouter directly ---
# OpenRouter key from https://openrouter.ai/keys (starts with "sk-or-")
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# Any OpenRouter model that supports tool calling. The free Nemotron model costs $0.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Simple mode (python roast.py): one call to your Dify chat app ---
# Dify app API key (Dify app > "API Access" > API Key, starts with "app-")
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# Dify Cloud. If you self-host Dify, use e.g. http://localhost/v1
DIFY_BASE_URL=https://api.dify.ai/v1

# How many commits to roast by default
COMMIT_COUNT=20
